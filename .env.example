# Entorno y servidor (Apartado 4)
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Base de datos PostgreSQL 17 (I5 prepara las bases locales portfolio_dev y portfolio_test)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_dev
DB_SSL=false
DB_CA_CERT_BASE64=
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_test

# Secretos de sesión y visitas (Generar valores distintos de 32 bytes hex con node:crypto)
SESSION_SECRET=
VISIT_SECRET=

# Supabase Storage (Lo configura I5 - dejar vacío en .env.example)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-media

# Correo transaccional Brevo (Lo configura I6 - dejar vacío en .env.example)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Reflection Tech
CONTACT_TO_EMAIL=