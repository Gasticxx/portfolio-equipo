<%- include('../partials/header', { tituloPagina }) %>

<main class="container py-4">
  <header class="mb-4">
    <h1 class="fw-bold">Servicios Profesionales</h1>
    <p class="text-secondary mb-0">
      Conocé las soluciones que ofrecemos como equipo fullstack y solicitá una cotización a medida.
    </p>
  </header>

  <% if (!servicios || servicios.length === 0) { %>
    <div class="alert alert-secondary" role="status">
      No hay servicios activos disponibles en este momento.
    </div>
  <% } else { %>
    <div class="row g-4">
      <% servicios.forEach((s) => { %>
        <div class="col-12 col-md-6 col-lg-4">
          <article class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
              <span class="badge text-bg-secondary align-self-start mb-2 text-uppercase">
                <%= s.categoria %>
              </span>
              <h2 class="h5 fw-bold mb-2"><%= s.nombre %></h2>
              <p class="card-text text-secondary flex-grow-1"><%= s.descripcion %></p>
              <a
                href="/contacto?tipo=cotizacion&servicioId=<%= s.id %>"
                class="btn btn-primary w-100 mt-3"
              >
                Solicitar cotización
              </a>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>