<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %> — Reflection Tech</title>
    <link rel="stylesheet" href="/vendor/bootstrap.min.css">
</head>
<body class="bg-light text-dark">
    <header class="border-bottom bg-white py-3 mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/" class="fw-bold fs-4 text-decoration-none text-primary">Reflection Tech</a>
            <nav class="d-flex gap-3">
                <a href="/" class="text-decoration-none text-dark">Inicio</a>
                <a href="/equipo" class="text-decoration-none text-secondary">Equipo</a>
                <a href="/servicios" class="text-decoration-none text-secondary">Servicios</a>
                <a href="/proyectos" class="text-decoration-none text-secondary">Proyectos</a>
                <a href="/contacto" class="text-decoration-none text-secondary">Contacto</a>
            </nav>
        </div>
    </header>

    <main class="container py-4">
        <div class="p-4 bg-white rounded-3 shadow-sm border">
            <h1 class="h2 fw-bold mb-3">Portfolio de Reflection Tech</h1>
            <p class="lead text-secondary mb-3">
                Entorno base Express 5 + EJS 3 + PostgreSQL 17 configurado correctamente.
            </p>
            <p class="mb-0 small text-muted">
                Estado del servidor: <strong>Operativo</strong> | Request ID: <code><%= requestId %></code>
            </p>
        </div>
    </main>

    <footer class="container py-4 mt-5 border-top text-secondary small">
        <span>Reflection Tech — Portfolio Colectivo Fullstack</span>
    </footer>
</body>
</html>