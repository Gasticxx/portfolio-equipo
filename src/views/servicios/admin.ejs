<%- include('../partials/header', { tituloPagina }) %>

<main class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h2 fw-bold mb-1">Gestión de Servicios</h1>
      <p class="text-secondary mb-0">Creá, editá y eliminá los servicios ofertados en el portfolio.</p>
    </div>
    <button type="button" id="btn-nuevo-servicio" class="btn btn-primary">
      Nuevo servicio
    </button>
  </div>

  <div id="alerta-admin-servicios" class="alert d-none" role="status" aria-live="polite"></div>

  <form id="form-filtros-servicios" class="row g-3 mb-4" novalidate>
    <div class="col-12 col-md-6">
      <label for="filtro-q" class="form-label">Buscar por nombre</label>
      <input
        type="search"
        id="filtro-q"
        name="q"
        class="form-control"
        placeholder="Ej. Desarrollo, Asesoría..."
        maxlength="80"
      />
    </div>
    <div class="col-12 col-md-4">
      <label for="filtro-activo" class="form-label">Estado</label>
      <select id="filtro-activo" name="activo" class="form-select">
        <option value="">Todos</option>
        <option value="true">Solo activos</option>
        <option value="false">Solo inactivos</option>
      </select>
    </div>
    <div class="col-12 col-md-2 d-flex align-items-end">
      <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
    </div>
  </form>

  <div class="table-responsive card shadow-sm">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col">Orden</th>
          <th scope="col">Nombre</th>
          <th scope="col">Categoría</th>
          <th scope="col">Estado</th>
          <th scope="col" class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody id="tabla-servicios-body">
        <% if (!servicios || servicios.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center text-secondary py-4">No se encontraron servicios.</td>
          </tr>
        <% } else { %>
          <% servicios.forEach((s) => { %>
            <tr data-servicio-id="<%= s.id %>">
              <td><%= s.orden %></td>
              <td>
                <div class="fw-semibold"><%= s.nombre %></div>
                <div class="small text-secondary text-truncate" style="max-width: 420px;"><%= s.descripcion %></div>
              </td>
              <td><span class="badge text-bg-secondary text-uppercase"><%= s.categoria %></span></td>
              <td>
                <% if (s.activo) { %>
                  <span class="badge text-bg-success">Activo</span>
                <% } else { %>
                  <span class="badge text-bg-secondary">Inactivo</span>
                <% } %>
              </td>
              <td class="text-end">
                <button
                  type="button"
                  class="btn btn-sm btn-outline-primary me-1 btn-editar-servicio"
                  data-id="<%= s.id %>"
                >
                  Editar
                </button>
                <button
                  type="button"
                  class="btn btn-sm btn-outline-danger btn-eliminar-servicio"
                  data-id="<%= s.id %>"
                  data-nombre="<%= s.nombre %>"
                >
                  Eliminar
                </button>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Modal accesible para Crear / Editar (Apartado 8 y 13) -->
  <div class="modal fade" id="modal-servicio" tabindex="-1" aria-labelledby="modal-servicio-titulo" aria-hidden="true">
    <div class="modal-dialog">
      <form id="form-servicio" class="modal-content" novalidate>
        <div class="modal-header">
          <h2 class="modal-title h5 fw-bold" id="modal-servicio-titulo">Nuevo servicio</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="servicio-id" />

          <div class="mb-3">
            <label for="servicio-nombre" class="form-label">Nombre del servicio</label>
            <input
              type="text"
              id="servicio-nombre"
              class="form-control"
              required
              minlength="3"
              maxlength="80"
              aria-describedby="ayuda-nombre error-nombre"
            />
            <div id="ayuda-nombre" class="form-text">Entre 3 y 80 caracteres.</div>
            <div id="error-nombre" class="invalid-feedback"></div>
          </div>

          <div class="mb-3">
            <label for="servicio-categoria" class="form-label">Categoría</label>
            <select id="servicio-categoria" class="form-select" required aria-describedby="error-categoria">
              <option value="web">Web</option>
              <option value="mantenimiento">Mantenimiento</option>
              <option value="asesoria">Asesoría</option>
            </select>
            <div id="error-categoria" class="invalid-feedback"></div>
          </div>

          <div class="mb-3">
            <label for="servicio-descripcion" class="form-label">Descripción</label>
            <textarea
              id="servicio-descripcion"
              class="form-control"
              rows="4"
              required
              minlength="20"
              maxlength="1000"
              aria-describedby="ayuda-descripcion error-descripcion"
            ></textarea>
            <div id="ayuda-descripcion" class="form-text">Texto plano de 20 a 1000 caracteres.</div>
            <div id="error-descripcion" class="invalid-feedback"></div>
          </div>

          <div class="row g-3">
            <div class="col-6">
              <label for="servicio-orden" class="form-label">Orden (1 a 100)</label>
              <input
                type="number"
                id="servicio-orden"
                class="form-control"
                min="1"
                max="100"
                value="1"
                required
                aria-describedby="error-orden"
              />
              <div id="error-orden" class="invalid-feedback"></div>
            </div>
            <div class="col-6 d-flex align-items-center pt-4">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="servicio-activo" checked />
                <label class="form-check-label" for="servicio-activo">Servicio activo</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" id="btn-guardar-servicio" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</main>

<script src="/js/servicios-admin.js" defer></script>
<%- include('../partials/footer') %>