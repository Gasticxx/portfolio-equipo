<%- include('../partials/i3/cabecera') %>
<link rel="stylesheet" href="/css/proyectos-publicos.css">
<div class="proyectos-publicos" id="explorar-resumen">
  <div class="explorar-regreso"><a class="regreso" href="/proyectos"><span class="regreso-icono" aria-hidden="true">←</span>Volver a proyectos</a></div>
  <section class="explorar-resumen-cabecera"><p class="eyebrow">PROYECTO COLECTIVO</p><h1><%= titulo %><span>.</span></h1><p class="explorar-bajada">Conocé el proyecto que reúne al equipo, sus tecnologías y las demos publicadas.</p></section>
  <section class="explorar-seccion explorar-catalogo" aria-label="Proyecto del equipo">
    <% if (disponible) { %><div class="explorar-coleccion"><%- include('../partials/catalogo-proyectos', { proyectos }) %></div>
    <% } else { %><p class="alerta alerta-aviso" role="status">No pudimos consultar el proyecto del equipo. Volvé a intentar en unos minutos.</p><% } %>
  </section>
</div>
<%- include('../partials/i3/pie') %>
