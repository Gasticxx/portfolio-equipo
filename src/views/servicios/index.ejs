<%- include('../partials/i3/cabecera') %>

<section class="encabezado-pagina">
  <a class="regreso" href="/">
    <span class="regreso-icono" aria-hidden="true">←</span>
    <span>Volver al inicio</span>
  </a>
  <p class="eyebrow">CAPACIDADES</p>
  <h1>Lo que podemos construir<span>.</span></h1>
  <p>Conocé nuestras capacidades y servicios.</p>
</section>

<div class="rejilla seccion">
  <% if (!servicios || servicios.length === 0) { %>
    <article class="glass servicio">
      <p class="eyebrow">SIN SERVICIOS</p>
      <h2>No hay servicios activos disponibles</h2>
      <p>En este momento no hay servicios publicados en el catálogo.</p>
    </article>
  <% } else { %>
    <% servicios.forEach((s) => { %>
      <article class="glass servicio revelar">
        <p class="eyebrow"><%= s.categoria ? s.categoria.toUpperCase() : 'SERVICIO' %></p>
        <h2><%= s.nombre %></h2>
        <p><%= s.descripcion %></p>
        <a class="enlace-flecha" href="/contacto?tipo=cotizacion&servicioId=<%= s.id %>">Consultar →</a>
      </article>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/i3/pie') %>