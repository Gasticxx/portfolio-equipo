<%- include('../partials/i3/cabecera') %>
<section class="encabezado-pagina"><a class="regreso" href="/i3"><span class="regreso-icono" aria-hidden="true">←</span><span>Volver al inicio</span></a><p class="eyebrow"><%= seccion.replace(/^\d+\s*\/\s*/, '') %></p><h1><%= titulo %><span>.</span></h1><p><%= descripcion %></p></section>
<% if (vista === 'equipo') { %><section class="rejilla seccion"><% integrantes.forEach(integrante => { %><%- include('../partials/i3/perfil', {integrante}) %><% }) %></section>
<% } else if (vista === 'perfil') { %><section class="perfil-detalle glass"><%- include('../partials/i3/perfil', {integrante}) %><div><h2>Sobre mí</h2><p><%= integrante.presentacion %></p><h3>Formación</h3><p><%= integrante.formacion %></p><h3>Tecnologías</h3><p><%= integrante.tecnologias.length ? integrante.tecnologias.join(' · ') : 'Espacio para completar con tecnologías verificadas.' %></p><h3>Enlaces</h3><% integrante.enlaces.forEach(enlace => { %><a href="<%= enlace.url %>" rel="noopener noreferrer"><%= enlace.nombre %></a><% }) %><h3>Aportes</h3><p>Responsabilidad asignada: <%= integrante.especialidad %>. Evidencias pendientes de integración.</p></div></section>
<% } else if (vista === 'proyectos') { %><div class="rejilla seccion"><%- include('../partials/i3/proyecto') %></div>
<% } else if (vista === 'servicios') { %><div class="rejilla seccion"><% ['Desarrollo de sitios web','Mantenimiento de aplicaciones','Asesoría técnica'].forEach((nombre,i) => { %><article class="glass servicio revelar"><p class="eyebrow">SERVICIO</p><h2><%= nombre %></h2><p><%= ['Construcción de sitios adaptables con presentación institucional, formularios y gestión de contenido.','Revisión y mejora de interfaces, corrección de errores y actualización de funciones de aplicaciones.','Orientación sobre estructura, tecnologías y alcance de un proyecto de software.'][i] %></p><a class="enlace-flecha" href="/i3/contacto">Consultar →</a></article><% }) %></div>
<% } else if (['contacto','login','registro'].includes(vista)) { %><section class="formulario-layout seccion"><aside><h2><%= vista === 'contacto' ? 'Contanos tu idea.' : 'Un lugar para conectar.' %></h2><p>Una interfaz clara, desde el primer paso.</p><%- include('../partials/i3/alerta', {tipo:'aviso',tituloAlerta:'Vista de interfaz',mensaje:'Este formulario permite revisar el diseño y sus validaciones. El envío y la sesión se integran con el módulo responsable.'}) %></aside><form class="glass formulario" data-formulario-ejemplo novalidate>
<% if(vista !== 'login') { %><%- include('../partials/i3/campo',{id:'nombre',etiqueta:'Nombre',tipo:'text',limite:80,ayuda:'Hasta 80 caracteres.',valor:''}) %><% } %>
<%- include('../partials/i3/campo',{id:'email',etiqueta:'Correo electrónico',tipo:'email',limite:254,ayuda:'Usá una dirección de correo válida.',valor:''}) %>
<% if(vista === 'contacto') { %><%- include('../partials/i3/campo',{id:'mensaje',etiqueta:'Mensaje',tipo:'textarea',limite:2000,ayuda:'Hasta 2000 caracteres. Contanos qué necesitás.',valor:''}) %><% } else { %><%- include('../partials/i3/campo',{id:'password',etiqueta:'Contraseña',tipo:'password',limite:128,ayuda:'La política definitiva se integra con autenticación.',valor:''}) %><% } %>
<button class="btn btn-primary" type="submit">Revisar formulario →</button><p role="status" data-formulario-estado></p></form></section>
<% } else if(vista === 'detalle') { %><section class="glass servicio seccion"><p class="eyebrow">EXPRESS / EJS / POSTGRESQL</p><h2>Portfolio del equipo Equipo Seis</h2><p>Portfolio colectivo con seis perfiles, proyectos protegidos, demos interactivas y gestión de consultas, usuarios y métricas. En desarrollo.</p><%- include('../partials/i3/alerta',{tipo:'aviso',tituloAlerta:'Muestras de interfaz',mensaje:'Estos enlaces abren prototipos locales sin datos reales. La publicación de demos necesita autorización y persistencia de I4 e I5.'}) %><div class="acciones"><a class="btn btn-primary" href="/i3/muestras/tablero">Interfaz del tablero ↗</a><a class="btn btn-glass" href="/i3/muestras/algoritmos">Interfaz del visualizador ↗</a></div></section>
<% } else if(vista === 'panel') { %><section class="seccion componentes"><%- include('../partials/i3/alerta',{tipo:'aviso',tituloAlerta:'Referencia de panel',mensaje:'I6 conecta filtros y gráficos; I2 provee las métricas. La autorización real corresponde a I4.'}) %><form class="glass formulario" data-formulario-ejemplo novalidate><h2>Filtros</h2><div class="controles-demo"><%- include('../partials/i3/campo',{id:'desde',etiqueta:'Desde',tipo:'date',limite:10,ayuda:'Inicio del período en horario de Argentina.',valor:''}) %><%- include('../partials/i3/campo',{id:'hasta',etiqueta:'Hasta',tipo:'date',limite:10,ayuda:'El día final se incluye completo.',valor:''}) %><div class="campo"><label for="tipo-consulta">Tipo de consulta</label><select id="tipo-consulta" class="form-select"><option>Todos los tipos</option><option>Cotización</option><option>Consulta general</option></select></div></div><button class="btn btn-primary" type="submit">Revisar filtros</button><p role="status" data-formulario-estado></p></form><h2>Indicadores y gráficos</h2><div class="rejilla"><% for(const tituloEstado of ['Visitas','Accesos autenticados','Consultas']) { %><%- include('../partials/i3/estado',{estado:'vacio',tituloEstado,mensaje:'Sin datos conectados. No se representan cifras ficticias.'}) %><% } %></div><%- include('../partials/i3/tabla',{tituloTabla:'Datos complementarios de los gráficos · pendiente de conexión',columnas:['Fecha','Tipo','Cantidad'],filas:[]}) %><a href="/i3/componentes">Ver estados de carga, error y confirmación →</a></section>
<% } else if(vista === 'componentes') { %><section class="seccion componentes"><h2>Estados y componentes compartidos</h2><%- include('../partials/i3/alerta',{tipo:'exito',tituloAlerta:'Operación correcta',mensaje:'La operación fue confirmada por el servidor.'}) %><%- include('../partials/i3/alerta',{tipo:'error',tituloAlerta:'No se pudo guardar',mensaje:'Tus datos se conservan. Revisá la conexión y volvé a intentar.'}) %><div class="rejilla"><% for(const [estado,tituloEstado,mensaje] of [['cargando','Cargando resultados','Esperá mientras se consulta la información.'],['vacio','Todavía no hay resultados','Probá otros filtros o agregá un registro.'],['error','No pudimos cargar los datos','Revisá la conexión y volvé a intentar.']]) { %><%- include('../partials/i3/estado',{estado,tituloEstado,mensaje}) %><% } %></div><%- include('../partials/i3/tabla',{tituloTabla:'Ejemplo de tabla adaptable · datos ilustrativos',columnas:['Código','Responsabilidad','Estado'],filas:integrantes.map(i=>[i.codigo,i.especialidad,'Asignado'])}) %><h3>Acciones de panel</h3><div class="acciones"><button class="btn btn-primary" disabled>Guardando…</button><button class="btn btn-outline-primary" data-confirmar-ejemplo>Eliminar ejemplo</button></div><dialog id="confirmacion-ejemplo" aria-labelledby="titulo-confirmacion"><h2 id="titulo-confirmacion">¿Eliminar el elemento?</h2><p>Ejemplo de confirmación. No se borrarán datos reales.</p><form method="dialog" class="acciones"><button class="btn btn-glass" value="cancelar" autofocus>Cancelar</button><button class="btn btn-danger" value="eliminar">Eliminar</button></form></dialog></section>
<% } %>
<%- include('../partials/i3/pie') %>
