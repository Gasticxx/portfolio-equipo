<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Sistema visual del portfolio colectivo Reflection Tech.">
  <title><%= titulo %> · Reflection Tech</title>
  <link rel="stylesheet" href="/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/ui.js" defer></script>
  <script src="/js/i3-fondo.js" defer></script>
  <script src="/js/i3-carrusel.js" defer></script>
  <% if (usuarioActual) { %>
    <script src="/js/auth/logout.js" defer></script>
  <% } %>
</head>
<body class="interfaz-i3">
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <div class="ambiente" aria-hidden="true"></div>
  <header class="cabecera">
    <div class="contenedor barra">
      <a class="marca" href="<%= typeof baseUi === 'string' ? baseUi : '/i3' %><%= typeof baseUi === 'string' && !baseUi ? '/' : '' %>"><span class="marca-icono" aria-hidden="true">R</span> Reflection <span class="marca-seis">Tech</span><span class="marca-punto">.</span></a>
      <button class="menu-boton btn btn-outline-primary" aria-expanded="false" aria-controls="navegacion">Menú <span aria-hidden="true">☰</span></button>
      <nav id="navegacion" class="navegacion" aria-label="Navegación principal">
        <% for (const [ruta, etiqueta] of [['/i3','Inicio'],['/i3/equipo','Equipo'],['/i3/servicios','Servicios'],['/i3/proyectos','Proyectos'],['/i3/contacto','Contacto']]) { %>
          <% const destino = typeof baseUi === "string" ? (ruta.replace(/^\/i3/, baseUi) || "/") : ruta; %>
          <a href="<%= destino %>" <%- destino === rutaActual ? 'aria-current="page"' : '' %>><%= etiqueta %></a>
        <% } %>
        <% if (!usuarioActual) { %>
          <%# La cabecera se comparte entre la maqueta de I3 y la aplicación. %>
          <%
            const enVistaPrevia = typeof rutaActual === "string"
              && (rutaActual === "/i3" || rutaActual.startsWith("/i3/"));
          %>
          <a class="acceso" href="<%= enVistaPrevia ? '/i3/login' : '/login' %>">Ingresar <span aria-hidden="true">↗</span></a>
          <a class="btn btn-primary" href="<%= enVistaPrevia ? '/i3/registro' : '/registro' %>">Registrarse</a>
        <% } else { %>
          <a href="/demos" <%- rutaActual === '/demos' ? 'aria-current="page"' : '' %>>Demos</a>
          <a href="/mi-cuenta">Mi cuenta</a>
          <% if (['operador','administrador'].includes(usuarioActual.rol)) { %><a href="/operador/consultas">Consultas</a><% } %>
          <% if (usuarioActual.rol === 'administrador') { %><a href="/admin">Administración</a><% } %>
          <button class="btn btn-outline-primary" type="button" data-salir>Salir</button>
        <% } %>
      </nav>
      <button class="tema-boton btn btn-glass" type="button" aria-label="Cambiar tema" aria-pressed="false" hidden></button>
    </div>
  </header>
  <main id="contenido" tabindex="-1" class="contenedor <%= /^\/(admin|operador)(\/|$)|^\/mi-cuenta$/.test(rutaActual) ? 'pagina-privada' : '' %>">
