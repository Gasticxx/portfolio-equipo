<% if (!proyectos.length) { %>
<article class="glass servicio"><h2>Estamos preparando nuevos proyectos</h2><p>Todavía no hay proyectos publicados.</p></article>
<% } else { for (const proyecto of proyectos) { %>
<article class="glass tarjeta-proyecto revelar">
  <div class="proyecto-portada">
    <% if (proyecto.portadaId) { %><img src="/media/<%= proyecto.portadaId %>" alt="Portada de <%= proyecto.titulo %>" loading="lazy">
    <% } else { %><span class="mini-ventana" aria-hidden="true"><span class="puntos">● ● ●</span><span class="mini-titulo">Reflection <span>Tech.</span></span><span class="mini-linea"></span><span class="mini-bloques"><i></i><i></i><i></i></span></span><% } %>
    <% if (typeof destacarEnInicio === 'boolean' && destacarEnInicio) { %><%- include('i3/proyecto-ornamentos') %><% } %>
    <span class="estado-proyecto"><%= proyecto.estado === 'terminado' ? 'Terminado' : 'En desarrollo' %></span>
  </div>
  <div class="perfil-texto">
    <p class="eyebrow"><%= proyecto.slug === 'portfolio-equipo' ? 'PROYECTO COLECTIVO / PORTFOLIO DEL EQUIPO' : 'PROYECTO DEL EQUIPO' %></p>
    <h3><%= proyecto.titulo %></h3><p><%= proyecto.resumen %></p>
    <div class="etiquetas"><% proyecto.tecnologias.forEach(tecnologia => { %><span><%= tecnologia %></span><% }) %></div>
    <a class="enlace-flecha" href="/proyectos/<%= proyecto.slug %>">Explorar proyecto <span aria-hidden="true">↗</span></a>
    <% if (typeof usuarioActual === 'undefined' || !usuarioActual) { %><p>Ingresá a tu cuenta para acceder al detalle y a las demos publicadas.</p><% } %>
  </div>
</article>
<% } } %>
