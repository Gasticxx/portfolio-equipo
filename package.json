{
  "name": "portfolio-equipo",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación web fullstack del **Equipo Seis**, desarrollada con Node.js 24 LTS, Express 5, EJS 3, PostgreSQL 17 y Bootstrap 5.",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "assets": "node scripts/vendor.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1",
    "test:unit": "node --test tests/unit",
    "cuenta:crear": "node --env-file=.env scripts/crear-cuenta.js",
    "cuenta:recuperar": "node --env-file=.env scripts/recuperar-cuenta.js",
    "db:limpiar": "node --env-file=.env scripts/limpiar.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gasticxx/portfolio-equipo.git"
  },
  "keywords": [],
  "author": "Equipo Seis",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Gasticxx/portfolio-equipo/issues"
  },
  "homepage": "https://github.com/Gasticxx/portfolio-equipo#readme",
  "dependencies": {
    "bootstrap": "5.3.8",
    "chart.js": "4.6.1",
    "connect-pg-simple": "10.0.0",
    "cookie-parser": "1.4.7",
    "ejs": "3.1.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "sharp": "0.34.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}