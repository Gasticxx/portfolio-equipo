<%- include('../partials/i3/cabecera') %>
<section class="encabezado-pagina"><a class="regreso" href="<%= typeof regresoProyecto === 'string' ? regresoProyecto : '/i3/detalle' %>">← Volver al proyecto</a><p class="eyebrow">LABORATORIO DE INTERFACES</p><h1><%= titulo %><span>.</span></h1><% if (typeof descripcionDemo === 'string') { %><p><%= descripcionDemo %></p><% } else if (typeof recursoJs === 'string') { %><p><%= vista === 'tablero' ? 'Tus tareas se guardan en tu cuenta. Podés retomarlas cuando vuelvas.' : 'Explorá los algoritmos con tus propios números, paso a paso o en reproducción automática.' %></p><% } else { %><p>Prototipo de I3 · datos de muestra, sin sesión ni persistencia.</p><% } %></section>
<% if (typeof recursoJs !== 'string') { %><%- include('../partials/i3/alerta',{tipo:'aviso',tituloAlerta:'Entorno de revisión visual',mensaje:'Esta muestra es independiente de las demos finales. I4 protege sus rutas e I5 conecta los datos y algoritmos antes de publicarlas.'}) %><% } %>
<% if(vista === 'tablero') { %>
<section class="seccion" data-tablero data-demo-id="<%= typeof demoId === 'number' ? demoId : '' %>" data-modo="<%= typeof recursoJs === 'string' ? 'integrado' : 'muestra' %>">
  <form class="glass demo-superior" data-tarea-form novalidate><div class="campo"><label for="titulo-tarea">Nueva tarea</label><input class="form-control" id="titulo-tarea" name="titulo" minlength="3" maxlength="80" required aria-describedby="titulo-tarea-ayuda titulo-tarea-error"><small id="titulo-tarea-ayuda">De 3 a 80 caracteres. Máximo 50 tareas.</small><span class="error-campo" id="titulo-tarea-error"></span></div><button class="btn btn-primary" type="submit">Agregar tarea +</button></form>
  <p role="status" aria-live="polite" data-tablero-estado></p>
  <div class="tablero"><% for(const [estado,nombre] of [['pendiente','Pendiente'],['progreso','En progreso'],['completada','Completada']]) { %><section class="columna" aria-label="<%= nombre %>"><h2><%= nombre %></h2><div data-columna="<%= estado %>"></div></section><% } %></div>
  <dialog data-eliminar-dialogo aria-labelledby="eliminar-titulo"><h2 id="eliminar-titulo">¿Eliminar esta tarea?</h2><p data-eliminar-nombre></p><form method="dialog" class="acciones"><button class="btn btn-glass" value="cancelar" autofocus>Cancelar</button><button class="btn btn-danger" value="eliminar">Eliminar</button></form></dialog>
</section><% if (typeof recursoJs === 'string') { %><script src="/js/tablero.adapter.js" defer></script><script src="<%= recursoJs %>" defer></script><% } else { %><script src="/js/tablero.js" defer></script><% } %>
<% } else if (vista === 'ondas') { %>
<%- include('../partials/i3/ondas', { recursoJs }) %>
<% } else if (vista === "calendario") { %>
<%- include("../partials/i3/calendario", { recursoJs }) %>
<% } else { %>
<%- include('../partials/i3/algoritmos') %>
<% } %>
<%- include('../partials/i3/pie') %>
